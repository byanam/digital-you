# ─────────────────────────────────────────────────────────────────────────────
# Digital You — environment
#
# EVERYTHING BELOW IS OPTIONAL.
# With no keys set, the app runs the fully local, offline reconstruction
# pipeline (parametric anatomical mesh + photo-projected UV texture).
#
# Copy to .env.local to use. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Which neural reconstruction backend to use when a key is present.
# One of: tripo | meshy | replicate | rodin
RECONSTRUCTION_PROVIDER=tripo

# The API key for the provider selected above.
# Leave blank / unset to force the local offline pipeline.
RECONSTRUCTION_API_KEY=

# Only for RECONSTRUCTION_PROVIDER=replicate — the model version hash to run.
# e.g. an ECON / PIFuHD / HMR 2.0 / TripoSR deployment on Replicate.
# Also accepted by meshy as the `ai_model` name (default: meshy-5).
RECONSTRUCTION_MODEL_VERSION=

# Only for RECONSTRUCTION_PROVIDER=replicate — the name of the input field the
# model expects the front photo on. Defaults to `image`; some models use
# `input_image`, `img`, or `image_path`.
RECONSTRUCTION_INPUT_KEY=

# Max seconds to wait for a neural job before falling back to the local
# pipeline. Clamped to 15…600. Default 90.
RECONSTRUCTION_TIMEOUT_SECONDS=180

# Provider CDNs do not send CORS headers, so generated meshes are streamed
# through /api/reconstruct/asset, and the URLs are HMAC-signed to keep that
# route from becoming an open proxy. If unset, the signing key is derived from
# RECONSTRUCTION_API_KEY — set this explicitly if you rotate keys while links
# are still live, or if you run several instances behind a load balancer.
RECONSTRUCTION_PROXY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: drop-in base body mesh for the local pipeline.
#
# If you have a licensed SMPL / SMPL-X / MakeHuman export, save it to
#   public/models/base-human.glb
# and the local pipeline will deform THAT mesh (bones + vertex scaling) instead
# of synthesising its own template. No env var needed — it is auto-detected.
# Set this only if you host the base mesh somewhere else.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_MESH_URL=
